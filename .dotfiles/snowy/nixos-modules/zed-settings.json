{
  "format_on_save": true,
  "disable_ai": true,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "debugger": {
    "dock": "right"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "icon_theme": {
    "mode": "system",
    "light": "Symbols Icon Theme",
    "dark": "Symbols Icon Theme"
  },
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "GitHub Dark Tritanopia",
    "dark": "GitHub Dark Tritanopia"
  },
  "auto_install_extensions": {
    "catppuccin-icons": true,
    "github-theme": true,
    "nix": true,
    "rust": true,
    "symbols": true,
    "toml": true
  },
  "languages": {
    "Nix": {
      "language_servers": ["nixd", "!nil"],
      "formatter": {
        "external": {
          "command": "alejandra",
          "arguments": ["--quiet", "--"]
        }
      }
    }
  },
  "lsp": {
    "nixd": {
      "settings": {
        "formatting": {
          "command": ["alejandra", "--quiet", "--"]
        }
      }
    }
  }
}
